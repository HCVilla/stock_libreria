APP_NAME="Librería Stock"
APP_VERSION=1.0.0
APP_AUTHOR="Ingeniero en Sistemas: Villanueva Cesar"
APP_ENV=local
# En producción usar APP_DEBUG=false
APP_DEBUG=true
APP_TIMEZONE=America/Argentina/Buenos_Aires
SESSION_LIFETIME=7200

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=libreria_stock
DB_USERNAME=stock_app
DB_PASSWORD=cambiar_esta_clave

# Credenciales usadas SOLO por bin/migrate.php para crear la base y el usuario.
# La aplicación usa DB_USERNAME / DB_PASSWORD.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
